{
  "bsonType": "object",
  "required": ["order_id", "remark_type", "remark_content"],
  "permission": {
    "read": true,
    "create": true,
    "update": "'admin' in auth.role",
    "delete": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "ID"
    },
    "order_id": {
      "bsonType": "string",
      "title": "会员订单ID",
      "description": "member_order._id"
    },
    "order_no": {
      "bsonType": "string",
      "title": "订单号（冗余）"
    },
    "customer_id": {
      "bsonType": "string",
      "title": "客户ID（冗余）"
    },
    "remark_type": {
      "bsonType": "string",
      "title": "备注类型",
      "description": "normal=普通 exception=异常 followup=跟进 system=系统处理日志（后台写入）",
      "enum": [
        { "value": "normal", "text": "普通备注" },
        { "value": "exception", "text": "异常备注" },
        { "value": "followup", "text": "跟进备注" },
        { "value": "system", "text": "系统日志" }
      ]
    },
    "remark_content": {
      "bsonType": "string",
      "title": "内容"
    },
    "operator_uid": {
      "bsonType": "string",
      "title": "操作人UID"
    },
    "operator_name": {
      "bsonType": "string",
      "title": "操作人展示名"
    },
    "created_at": {
      "bsonType": "timestamp",
      "title": "创建时间",
      "forceDefaultValue": { "$env": "now" }
    }
  }
}
