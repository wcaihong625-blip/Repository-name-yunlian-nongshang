{

  "bsonType": "object",

  "required": ["order_no", "user_id", "price"],

  "permission": {

    "read": "true",

    "create": "true",

    "update": "'admin' in auth.role",

    "delete": "false"

  },

  "properties": {

    "_id": { "description": "ID" },

    "order_no": { "bsonType": "string", "title": "订单编号" },

    "user_id": { "bsonType": "string", "title": "用户ID" },

    "nickname": { "bsonType": "string", "title": "用户昵称" },

    "content_id": { "bsonType": "string", "title": "信息ID" },

    "content_type": {

      "bsonType": "string",

      "title": "信息类型",

      "enum": ["purchase", "supply"]

    },

    "title": { "bsonType": "string", "title": "信息标题" },

    "promotion_type": {

      "bsonType": "string",

      "title": "推广类型",

      "enum": ["top", "boost"]

    },

    "duration_days": { "bsonType": "int", "title": "推广时长(天)" },

    "price": { "bsonType": "double", "title": "应付金额(元)" },

    "origin_price": { "bsonType": "double", "title": "原价(元)" },

    "member_type": {

      "bsonType": "string",

      "title": "下单时会员身份",

      "enum": ["free", "personal", "enterprise"]

    },

    "pay_status": {

      "bsonType": "int",

      "title": "支付状态",

      "description": "0待支付 1已支付 2已取消",

      "enum": [{ "value": 0, "text": "待支付" }, { "value": 1, "text": "已支付" }, { "value": 2, "text": "已取消" }]

    },

    "status": {

      "bsonType": "string",

      "title": "业务状态",

      "enum": ["pending", "paid", "active", "expired", "cancelled"]

    },

    "start_time": { "bsonType": "timestamp", "title": "开始时间" },

    "end_time": { "bsonType": "timestamp", "title": "结束时间" },

    "before_view_count": {

      "bsonType": "int",

      "title": "推广生效前浏览量",

      "description": "推广激活瞬间从供应/采购主表读取的 view_count 快照，用于效果对比"

    },

    "pay_time": { "bsonType": "timestamp", "title": "支付时间" },

    "pay_mock_flag": {

      "bsonType": "bool",

      "title": "历史测试支付标记（不推荐写入）",

      "description": "仅历史展示/排查：非 uni-pay 正式链路的旧数据标记；不参与正式支付与推广落账判断。"

    },

    "use_gift_quota": {

      "bsonType": "bool",

      "title": "是否使用会员赠送天数抵扣",

      "description": "为 true 时表示本单使用「赠送置顶天数」或「赠送加急曝光天数」抵扣（0 元单）；与 promotion_type 对应。"

    },

    "gift_quota_type": {

      "bsonType": "string",

      "title": "赠送抵扣类型（置顶/加急）",

      "description": "top：扣减赠送置顶天数；boost：扣减赠送加急曝光天数；none：未使用赠送抵扣",

      "enum": ["top", "boost", "none"]

    },

    "gift_quota_count": {

      "bsonType": "int",

      "title": "本次抵扣赠送天数",

      "description": "与 duration_days 一致，表示本单从用户赠送额度中抵扣的天数（常见 1、3、7 天）"

    },

    "gift_quota_applied": {

      "bsonType": "bool",

      "title": "赠送天数是否已从用户账户扣除",

      "description": "激活成功后为 true，防止同一订单重复扣减赠送天数"

    },

    "created_at": {

      "bsonType": "timestamp",

      "title": "创建时间",

      "forceDefaultValue": { "$env": "now" }

    },

    "updated_at": {

      "bsonType": "timestamp",

      "title": "更新时间",

      "forceDefaultValue": { "$env": "now" }

    }

  }

}

