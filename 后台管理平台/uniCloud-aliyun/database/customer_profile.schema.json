{
  "bsonType": "object",
  "required": ["mobile"],
  "permission": {
    "read": "true",
    "create": "true",
    "update": "true",
    "delete": "'admin' in auth.role"
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "ID"
    },
    "user_id": {
      "bsonType": "string",
      "title": "用户ID"
    },
    "mobile": {
      "bsonType": "string",
      "title": "手机号",
      "pattern": "^1[3-9]\\d{9}$"
    },
    "nickname": {
      "bsonType": "string",
      "title": "昵称"
    },
    "avatar": {
      "bsonType": "string",
      "title": "头像"
    },
    "company_name": {
      "bsonType": "string",
      "title": "企业名称"
    },
    "contact_name": {
      "bsonType": "string",
      "title": "联系人"
    },
    "region": {
      "bsonType": "string",
      "title": "地区"
    },
    "customer_type": {
      "bsonType": "int",
      "title": "客户类型",
      "description": "0-普通用户 1-供应 2-采购",
      "defaultValue": 0
    },
    "member_status": {
      "bsonType": "int",
      "title": "会员状态",
      "description": "0-未开通 1-已开通 2-已过期",
      "defaultValue": 0,
      "enum": [
        {"value": 0, "text": "未开通"},
        {"value": 1, "text": "已开通"},
        {"value": 2, "text": "已过期"}
      ]
    },
    "member_expire_time": {
      "bsonType": "timestamp",
      "title": "会员过期时间"
    },
    "source_channel_id": {
      "bsonType": "string",
      "title": "来源渠道ID"
    },
    "source_channel_name": {
      "bsonType": "string",
      "title": "来源渠道名称"
    },
    "first_sales_id": {
      "bsonType": "string",
      "title": "首次归属业务员ID"
    },
    "first_sales_name": {
      "bsonType": "string",
      "title": "首次归属业务员姓名"
    },
    "current_sales_id": {
      "bsonType": "string",
      "title": "当前服务业务员ID"
    },
    "current_sales_name": {
      "bsonType": "string",
      "title": "当前服务业务员姓名"
    },
    "first_bind_time": {
      "bsonType": "timestamp",
      "title": "首次绑定时间"
    },
    "member_first_open_time": {
      "bsonType": "timestamp",
      "title": "首次开通会员时间"
    },
    "member_last_renew_time": {
      "bsonType": "timestamp",
      "title": "最后一次续费时间"
    },
    "transfer_status": {
      "bsonType": "int",
      "title": "转移状态",
      "description": "0-无 1-转移审批中",
      "defaultValue": 0
    },
    "transfer_count": {
      "bsonType": "int",
      "title": "转移次数记录",
      "defaultValue": 0
    },
    "remark": {
      "bsonType": "string",
      "title": "备注"
    },
    "created_at": {
      "bsonType": "timestamp",
      "title": "创建时间",
      "forceDefaultValue": {"$env": "now"}
    },
    "updated_at": {
      "bsonType": "timestamp",
      "title": "更新时间",
      "forceDefaultValue": {"$env": "now"}
    }
  }
}
